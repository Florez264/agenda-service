# Cargar en las variables del servicio cloud correspondiente. Nunca versionar valores reales.
SPRING_PROFILES_ACTIVE=cloud
DB_URL=jdbc:mysql://HOST:3306/BASE?sslMode=VERIFY_IDENTITY&connectionTimeZone=UTC
DB_USER=
DB_PASSWORD=
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
API_USER=
API_PASSWORD=
INTERNAL_USER=
INTERNAL_PASSWORD=
DB_POOL_SIZE=2
JAVA_TOOL_OPTIONS=-Xms32m -Xmx192m -XX:MaxDirectMemorySize=32m -XX:+UseSerialGC -XX:ActiveProcessorCount=2 -XX:+ExitOnOutOfMemoryError
ORDENES_URL=http://ordenes-service.railway.internal:8081
# LOG no necesita credenciales ni envía mensajes externos.
NOTIFICATIONS_MODE=LOG
NOTIFICATIONS_WORKER_ENABLED=true
NOTIFICATIONS_POLL_DELAY_MS=60000
NOTIFICATIONS_INITIAL_DELAY_MS=10000
NOTIFICATIONS_BATCH_SIZE=5
NOTIFICATIONS_MAX_ATTEMPTS=3
NOTIFICATIONS_LEASE_SECONDS=60
NOTIFICATIONS_RETRY_SECONDS=30
# Cambiar a WHATSAPP solo después de completar las variables siguientes.
WHATSAPP_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Opcional: tu número verificado con indicativo, sin +. Vacío usa el teléfono de la orden.
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_DEFAULT_COUNTRY_CODE=57
WHATSAPP_TIME_ZONE=America/Bogota
# hello_world/en_US es solo el saludo de prueba que verificaste en Meta.
WHATSAPP_TEMPLATE_SCHEDULED=hello_world
WHATSAPP_TEMPLATE_SCHEDULED_LANGUAGE=en_US
WHATSAPP_TEMPLATE_SCHEDULED_PARAMS=
WHATSAPP_TEMPLATE_CANCELLED=hello_world
WHATSAPP_TEMPLATE_CANCELLED_LANGUAGE=en_US
WHATSAPP_TEMPLATE_CANCELLED_PARAMS=

# Origen del frontend, sin barra final; varios separados por coma.
CORS_ALLOWED_ORIGINS=https://tu-frontend.example.com

# Puerto estable para referencias privadas entre servicios.
PORT=8082
HTTP_MAX_THREADS=16

# Sincronizacion fiable de cierre de ordenes (sin WhatsApp)
ORDER_CLOSURES_WORKER_ENABLED=true
ORDER_CLOSURES_POLL_DELAY_MS=15000
